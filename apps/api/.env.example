PORT=4000
DATABASE_URL=postgresql://gp:gp_secret@localhost:5432/gp_service?schema=public
AI_ASSISTANT_URL=http://localhost:8010
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
# DuckDNS production:
# NODE_ENV=production
# DATABASE_URL=postgresql://gp:CHANGE_ME@postgres:5432/gp_service?schema=public
# JWT_SECRET=generate-a-random-secret-min-32-chars
# PUBLIC_API_URL=https://apigp.duckdns.org
# AI_ASSISTANT_URL=https://ai-gp.duckdns.org
# CORS_ORIGINS=https://admingp.duckdns.org,https://servicegp.duckdns.org,https://partnergp.duckdns.org
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Файлдар (маман фотолары) — локальді каталог, URL: http://localhost:4000/uploads/...
# UPLOAD_DIR=./uploads
# Prod: толық API URL (upload сілтемелері үшін), мысалы https://apigp.duckdns.org
# PUBLIC_API_URL=https://apigp.duckdns.org/api

# Mobile OTP (gpartners-portal-api сияқты WhatsApp queue)
WHATSAPP_SERVICE_URL=https://wp.gpartners.kz/queues/push
WHATSAPP_SERVICE_TOKEN=
# SMS провайдер (опционал): POST { phone, code, channel }
# OTP_WEBHOOK_URL=

# App Store / Play review (prod, тек verify): send әдеттегідей WhatsApp
# OTP_STORE_REVIEW_PHONE=+77754117282
# OTP_STORE_REVIEW_CODE=777777

# Dev: барлық нөмірлер үшін OTP bypass (prod-та қоспаңыз)
# OTP_DEV_BYPASS_ENABLED=false
# OTP_DEV_BYPASS_CODE=777777

# Legal entity verification / eGov Kazakhstan integration.
# mock keeps development working without storing extra government data.
EGOV_PROVIDER=mock
# EGOV_PROVIDER=egov
# EGOV_API_TOKEN=
# EGOV_COMPANY_VERIFY_URL=
# NCALAYER_VERIFY_URL=
# EGOV_MOBILE_ECP_VERIFY_URL=

# MOBILE_OTP_FIXED=123456
# MOBILE_ACCESS_EXPIRES_IN=15m
# MOBILE_REFRESH_DAYS=30
