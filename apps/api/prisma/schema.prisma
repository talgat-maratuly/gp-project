model Region {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users      User[]
  partners   PartnerProfile[]
  stores     Store[]
  products   MarketProduct[]
  stocks     Stock[]
  orders     MarketOrder[]
  franchises Franchise[]
  specialistRequests SpecialistRequest[]
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
  BLOCKED
}

model Store {
  id             String      @id @default(uuid())
  name           String
  ownerId        String
  owner          User        @relation("StoreOwner", fields: [ownerId], references: [id])
  regionId       String
  region         Region      @relation(fields: [regionId], references: [id])
  address        String?
  phone          String?
  status         StoreStatus @default(PENDING_REVIEW)
  isOfflineStore Boolean     @default(false)
  createdAt      DateTime    @default(now())

  products MarketProduct[]
  stocks   Stock[]
  orders   MarketOrder[]

  @@index([ownerId])
  @@index([regionId])
  @@index([status])
}

