  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id])
  name        String
  description String?  @default("")
  categoryId  String
  price       Decimal  @db.Decimal(12, 2)
  images      Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stock      Stock?
  orderItems MarketOrderItem[]

  @@index([storeId])
  @@index([regionId])
  @@index([isActive])
  @@index([categoryId])
}

model Stock {
  id               String        @id @default(uuid())
  productId        String        @unique
  product          MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  regionId         String
  region           Region        @relation(fields: [regionId], references: [id])
  quantity         Int           @default(0)
  reservedQuantity Int           @default(0)

  @@index([storeId])
  @@index([regionId])
}

enum MarketOrderStatus {
  NEW
  ACCEPTED
  PAID
  PACKING
  READY_FOR_PICKUP
  COURIER_ASSIGNED
  IN_DELIVERY
  DELIVERED
  CANCELLED
  PROBLEM
}

enum MarketDeliveryType {
  DELIVERY
  PICKUP
}

model MarketOrder {
  id           String              @id @default(uuid())
  customerId   String
  customer     User                @relation(fields: [customerId], references: [id])
  regionId     String
  region       Region              @relation(fields: [regionId], references: [id])
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id])
  totalAmount  Decimal             @db.Decimal(12, 2)
  status       MarketOrderStatus   @default(NEW)
  deliveryType MarketDeliveryType
  address      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  items MarketOrderItem[]

  @@index([customerId])
  @@index([regionId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model MarketOrderItem {
  id        String        @id @default(uuid())
  orderId   String
  order     MarketOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   MarketProduct @relation(fields: [productId], references: [id])
  name      String
  price     Decimal       @db.Decimal(12, 2)
  qty       Int           @default(1)

  @@index([orderId])
  @@index([productId])
}
