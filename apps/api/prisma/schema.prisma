generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PARTNER
  ADMIN
  SUPER_ADMIN
  REGION_ADMIN
}

/// Portal RBAC — көп рөлді қолжетімділік (UserRole spec)
enum PortalRole {
  CLIENT
  SPECIALIST
  GP_OPERATOR
  FRANCHISE_OWNER
  GLOBAL_OPERATOR
  ADMIN
}

/// Физическое или юридическое лицо (клиент и партнёр)
enum AccountType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum PartnerDirection {
  SEPTIC
  LAWN
  AUTOWATERING
  PUMPS
  FILTERS
  NURSERY
  SHOP
  DELIVERY
  LANDSCAPE
  ELECTRICAL
}

/// Статус модерации отдельной подуслуги партнёра (не всего аккаунта)
enum PartnerOfferingStatus {
  PENDING_MODERATION
  ACTIVE
  TEMPORARILY_BLOCKED
  REJECTED
}

enum PartnerType {
  SEPTIC_SERVICE
  LAWN_MOWING
  IRRIGATION_SERVICE
  CLEANING_SERVICE
  SHOP
  NURSERY
  SPECIALIST
  DELIVERY
  OTHER
}

/** Роль для меню и прав: специалист / магазин / оба (после одобрения) */
enum PartnerRole {
  SPECIALIST
  SHOP
  MIXED_PARTNER
}

enum PartnerStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
  SUSPENDED
}

enum NurseryProductStatus {
  AVAILABLE
  UNAVAILABLE
  PREORDER_ONLY
}

enum NurseryRequestStatus {
  CREATED
  OFFERED
  ACCEPTED
  CANCELLED
  COMPLETED
}

enum NurseryOfferStatus {
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum GrowingPreorderStatus {
  CREATED
  OFFERED
  ACCEPTED
  CONTRACT_PENDING
  IN_GROWING
  READY_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryPartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DeliveryOrderStatus {
  CREATED
  OFFERED
  ACCEPTED
  PICKUP_SCHEDULED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryOfferStatus {
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Specialist moderation request (PartnerProfile) — PartnerStatus-тан бөлек
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpecialistRejectionReasonCode {
  DOCUMENTS_UNCLEAR
  MISSING_PHOTOS
  INCORRECT_INFORMATION
  VEHICLE_NOT_SUITABLE
  OTHER
}

/// Platform access — барлық User
enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AccountStatusChangeType {
  AUTO
  OPERATOR
  SYSTEM
}

/// Specialist availability — тек PartnerProfile
enum WorkStatus {
  ONLINE
  OFFLINE
  BUSY
  ON_ROUTE
}

enum PartnerModerationAction {
  APPROVE
  REJECT
  REVISION
  SUSPEND
  RESTORE
  RESUBMIT
}

enum OrderCategory {
  SEPTIC
  LAWN
  AUTOWATERING
  PUMPS
  FILTERS
  SHOP
  ELECTRICAL
}

enum ServiceProjectType {
  hunter_irrigation
  furniture
}

enum ServiceProjectStatus {
  draft
  submitted
  review
  assigned
  in_progress
  completed
  cancelled
}

enum OrderStatus {
  NEW
  ACCEPTED
  ON_WAY
  IN_PROCESS
  COMPLETED
  EXPIRED
  CANCELED_BY_CLIENT
  CANCELED_BY_SPEC
  NO_SHOW
}

/// Операционные под-статусы септик-рейса (только при ON_WAY / IN_PROCESS)
enum SepticStage {
  ARRIVED
  PUMPING
  LOADED
  DISPOSAL_ARRIVED
  DISPOSAL_COMPLETED
}

/// Кто инициировал переход статуса (для аудита и нотификаций)
enum OrderActorRole {
  client
  spec
  system
  admin
}

enum GeofenceZoneType {
  SEPTIC_DISPOSAL
  STATION
  POLYGON
  UNLOAD_POINT
}

enum MovementState {
  IDLE
  MOVING
  STOPPED
}

enum DisposalEventType {
  LEGAL
  ILLEGAL
  SUSPECTED
}

enum LawnWorkType {
  MOWING
  CARE
  CLEANUP
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  KASPI_DIRECT_TO_PARTNER
}

enum BalanceTransactionType {
  TOPUP
  COMMISSION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  /// Канондық RBAC рөлдері (JWT + guards). Бос болса — legacy Role-дан resolve
  portalRoles  PortalRole[] @default([CLIENT])
  name         String
  phone        String?
  regionId     String?
  region       Region?  @relation(fields: [regionId], references: [id])
  franchiseId  String?
  franchise    Franchise? @relation(fields: [franchiseId], references: [id])
  accountStatus AccountStatus @default(ACTIVE)
  accountStatusReason String?
  accountStatusChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfile  ClientProfile?
  partnerProfile PartnerProfile?
  refreshTokens  AuthRefreshToken[]
  devices        UserDevice[]
  passwordResets PasswordResetChallenge[]
  ownedStores    Store[]          @relation("StoreOwner")
  marketOrders   MarketOrder[]
  approvedPartners PartnerProfile[] @relation("PartnerApprovedBy")
  moderationActions PartnerModerationAuditLog[] @relation("ModerationAdmin")
  specialistRequests SpecialistRequest[]
  moderatedSpecialistRequests SpecialistRequest[] @relation("SpecialistRequestModerator")
  accountStatusLogs AccountStatusLog[] @relation("AccountStatusSubject")
  accountStatusChanges AccountStatusLog[] @relation("AccountStatusChangedBy")
  complaintsReceived UserComplaint[] @relation("ComplaintTarget")
  complaintsFiled UserComplaint[] @relation("ComplaintReporter")

  @@index([regionId])
  @@index([franchiseId])
  @@index([accountStatus])
}

model AccountStatusLog {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation("AccountStatusSubject", fields: [userId], references: [id], onDelete: Cascade)
  oldStatus   AccountStatus
  newStatus   AccountStatus
  changeType  AccountStatusChangeType
  reason      String
  rule        String?
  changedById String?
  changedBy   User?                   @relation("AccountStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([userId])
  @@index([newStatus])
  @@index([changeType])
  @@index([rule])
  @@index([createdAt])
}

model UserComplaint {
  id             String   @id @default(uuid())
  targetUserId   String
  targetUser     User     @relation("ComplaintTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reporter       User?    @relation("ComplaintReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  regionId       String?
  reason         String
  createdAt      DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([regionId])
}

/// Франшиза (аймақтық масштабтау)
model Franchise {
  id        String   @id @default(uuid())
  name      String
  city      String?
  cityId    String?
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  services FranchiseService[]

  @@index([regionId])
}

/// Қызмет түрі — франшиза/қала бойынша (3 тіл, баға, active)
model FranchiseService {
  id           String   @id @default(uuid())
  franchiseId  String
  franchise    Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  templateId   String
  cityId       String?
  names        Json
  basePrice    Int      @default(0)
  gpCommission Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subservices FranchiseSubservice[]

  @@unique([franchiseId, templateId])
  @@index([franchiseId])
}

/// Подуслуга — франшиза қызметі ішінде (3 тіл, баға, active)
model FranchiseSubservice {
  id                 String           @id @default(uuid())
  franchiseServiceId String
  franchiseService   FranchiseService @relation(fields: [franchiseServiceId], references: [id], onDelete: Cascade)
  externalId         String?
  names              Json
  price              Int              @default(0)
  gpCommission       Int              @default(0)
  active             Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([franchiseServiceId])
}

/// Глобалды қызмет түрі (code + 3 тіл)
model ServiceType {
  id        String   @id @default(uuid())
  code      String   @unique
  names     Json
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subserviceTypes SubserviceType[]
  cityPrices      CityServicePrice[]
}

/// Глобалды подуслуга түрі
model SubserviceType {
  id            String      @id @default(uuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  code          String
  names         Json
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cityPrices CityServicePrice[]

  @@unique([serviceTypeId, code])
  @@index([serviceTypeId])
}

/// Қала бойынша баға (septic және басқа қызметтер)
model CityServicePrice {
  id               String          @id @default(uuid())
  serviceTypeId    String
  serviceType      ServiceType     @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  subserviceTypeId String?
  subserviceType   SubserviceType? @relation(fields: [subserviceTypeId], references: [id], onDelete: SetNull)
  oblastId         String?
  cityId           String
  franchiseId      String?
  price            Int
  gpCommission     Int             @default(0)
  active           Boolean         @default(true)
  volumeStart      Int?
  volumeEnd        Int?
  priority         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cityId])
  @@index([serviceTypeId, cityId])
  @@index([franchiseId])
}

model ClientProfile {
  id        String      @id @default(uuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType AccountType @default(INDIVIDUAL)
  legalForm   String?
  companyName String?
  bin         String?
  legalAddress String?
  contactPerson String?
  legalVerificationStatus String @default("VERIFIED")
  legalReviewComment String?
  legalVerifiedAt DateTime?
  legalRejectedAt DateTime?
  egovCheckStatus String @default("NOT_REQUIRED")
  egovProvider String?
  egovCheckedAt DateTime?
  ecpStatus String @default("PENDING")
  ecpOwnerType String?
  ecpSubject String?
  ecpBoundAt DateTime?
  city      String?     @default("Уральск")
  createdAt DateTime    @default(now())

  orders Order[]
  serviceProjects ServiceProject[]
  plantCases PlantCase[]
  nurseryRequests NurseryRequest[]
  growingPreorders GrowingPreorder[]
  deliveryOrders DeliveryOrder[]
}

model PartnerProfile {
  id           String             @id @default(uuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionId     String?
  region       Region?            @relation(fields: [regionId], references: [id])
  partnerType  PartnerType?
  partnerRole  PartnerRole?
  status       PartnerStatus      @default(DRAFT)
  /// Specialist moderation (Request Status) — status-тан тәуелсіз
  requestStatus RequestStatus?
  /// Specialist availability (Work Status)
  workStatus   WorkStatus         @default(OFFLINE)
  accountType  AccountType        @default(INDIVIDUAL)
  companyName  String?
  company      String?
  fullName     String?
  bin          String?
  legalAddress String?
  address      String?
  description  String?
  /** Удостоверение / ИИН для физлица-специалиста */
  idDocumentNumber String?
  /** Реквизиты и документы: [{ kind, number, note, url? }] */
  documents    Json?
  rejectionReason String?
  revisionComment String?
  approvedByAdminId String?
  approvedByAdmin   User?          @relation("PartnerApprovedBy", fields: [approvedByAdminId], references: [id])
  approvedAt   DateTime?
  rejectedAt   DateTime?
  suspendedAt  DateTime?
  /** Необязательный код приглашения при регистрации */
  referralCode String?
  directions   PartnerDirection[]
  /// furniture_manufacturing | furniture_assembly | furniture_repair
  serviceAccess FurnitureServiceType[] @default([])
  balance    Decimal            @default(10000) @db.Decimal(12, 2)
  isOnline   Boolean            @default(false)
  lat        Float?             @default(51.243)
  lng        Float?             @default(51.377)
  city       String?            @default("Уральск")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  moderationAudit PartnerModerationAuditLog[]
  products     Product[]
  orders       Order[]              @relation("AssignedPartner")
  qrCodeObjects QRCodeObject[]
  qrServiceOrders QRServiceOrder[] @relation("QrAssignedPartner")
  transactions BalanceTransaction[]
  geoUpdates   GeoUpdate[]
  serviceOfferings PartnerServiceOffering[]
  gpsPoints    GpsPoint[]
  trips        Trip[]
  serviceProjects ServiceProject[] @relation("AssignedPartnerProjects")
  furnitureExecutorOrders FurnitureExecutorOrder[] @relation("FurnitureExecutorPartner")
  specialistRequests SpecialistRequest[]
  assignedPlantCases PlantCase[] @relation("PlantCaseAssignedPartner")
  statusEvents PartnerStatusEvent[]
  locations    PartnerLocation[]
  vehicles     PartnerVehicle[]
  availability PartnerAvailability?
  nurseries    Nursery[]
  nurseryOffers NurseryOffer[]
  growingContracts GrowingContract[]
  deliveryPartner DeliveryPartner?
  deliveryOffers DeliveryOffer[]

  @@index([regionId])
  @@index([status])
  @@index([partnerType])
  @@index([partnerRole])
}

model PartnerStatusEvent {
  id        String         @id @default(uuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  status    WorkStatus
  orderId   String?
  reason    String?
  createdAt DateTime       @default(now())

  @@index([partnerId, createdAt])
  @@index([status])
  @@map("partner_status")
}

model PartnerLocation {
  id         String         @id @default(uuid())
  partnerId  String
  partner    PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orderId    String?
  lat        Float
  lng        Float
  accuracyM  Float?
  visibleToClient Boolean   @default(false)
  createdAt  DateTime       @default(now())

  @@index([partnerId, createdAt])
  @@index([orderId, createdAt])
  @@map("partner_location")
}

model PartnerVehicle {
  id          String         @id @default(uuid())
  partnerId   String
  partner     PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category    OrderCategory  @default(SEPTIC)
  vehicleType String         @default("septic_truck")
  volumeM3    Int?
  quantity    Int            @default(1)
  status      WorkStatus     @default(OFFLINE)
  meta        Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([partnerId])
  @@index([category, volumeM3])
  @@index([status])
  @@map("partner_vehicle")
}

model PartnerAvailability {
  id             String         @id @default(uuid())
  partnerId      String         @unique
  partner        PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  city           String?
  serviceIds     String[]       @default([])
  status         WorkStatus     @default(OFFLINE)
  activeOrderId  String?
  etaFreeAt      DateTime?
  lastSeenAt     DateTime?
  updatedAt      DateTime       @updatedAt

  @@index([city])
  @@index([status])
  @@map("partner_availability")
}

/// Specialist moderation request — бір user → бірнеше өтінім (бір негізгі қызмет / өтінім)
model SpecialistRequest {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)

  regionId         String
  region           Region        @relation(fields: [regionId], references: [id])
  city             String?
  district         String?
  /// Бір өтінім = бір негізгі қызмет (OrderCategory)
  primaryCategory  OrderCategory
  subserviceIds    String[]      @default([])
  primarySubserviceId String?

  status           RequestStatus

  profilePhotoUrl    String?
  idCardFrontUrl     String?
  idCardBackUrl      String?
  vehicleData        Json?
  equipmentPhotoUrls String[]    @default([])
  workExperience     String?
  termsAcceptedAt    DateTime?
  personalDataAcceptedAt DateTime?

  moderatorId      String?
  moderator        User?         @relation("SpecialistRequestModerator", fields: [moderatorId], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  rejectionReasonCode SpecialistRejectionReasonCode?
  rejectedAt       DateTime?
  resubmittedAt    DateTime?

  offerings        PartnerServiceOffering[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, primaryCategory])
  @@index([partnerProfileId])
  @@index([regionId])
  @@index([status])
  @@index([createdAt])
  @@index([city])
}

enum FurnitureServiceType {
  furniture_manufacturing
  furniture_assembly
  furniture_repair
}

model FurnitureExecutorOrder {
  id                String              @id @default(uuid())
  serviceType       FurnitureServiceType
  serviceProjectId  String?             @unique
  clientName        String
  phone             String
  address           String
  comment           String?
  city              String?             @default("Уральск")
  status            QrOrderStatus       @default(new)
  assignedPartnerId String?
  partner           PartnerProfile?     @relation("FurnitureExecutorPartner", fields: [assignedPartnerId], references: [id])
  executorInternal  Boolean             @default(true)
  totalPrice        Float               @default(0)
  gpCommission      Float               @default(0)
  franchiseId       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([assignedPartnerId])
  @@index([serviceType])
  @@index([status])
}

/** Подуслуга партнёра с отдельным статусом модерации (не блокирует весь аккаунт). */
model PartnerServiceOffering {
  id            String                @id @default(uuid())
  partnerId     String
  partner       PartnerProfile        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  specialistRequestId String?
  specialistRequest   SpecialistRequest? @relation(fields: [specialistRequestId], references: [id], onDelete: Cascade)
  /** Идентификатор подуслуги как в каталоге (например grass-mowing) или gp-shop для магазина */
  subserviceId  String
  status        PartnerOfferingStatus @default(PENDING_MODERATION)
  moderationNote String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([partnerId, subserviceId])
  @@index([partnerId])
  @@index([specialistRequestId])
  @@index([status])
}

model PartnerModerationAuditLog {
  id         String                  @id @default(uuid())
  partnerId  String
  partner    PartnerProfile          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  adminUserId String?
  admin      User?                   @relation("ModerationAdmin", fields: [adminUserId], references: [id])
  action     PartnerModerationAction
  reason     String?
  comment    String?
  createdAt  DateTime                @default(now())

  @@index([partnerId])
  @@index([adminUserId])
  @@index([createdAt])
}

model Product {
  id          String   @id @default(uuid())
  partnerId   String
  partner     PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  category    String
  brand       String?  @default("Partner")
  description String?  @default("")
  /** Многострочные характеристики: обычно «Название: значение» по одной строке */
  specifications String?
  inStock     Boolean  @default(true)
  /// hunter_irrigation | furniture — связь с GP Market / расчётами
  linkedServiceType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  qrCodeObjects QRCodeObject[]

  @@index([partnerId])
  @@index([linkedServiceType])
  @@index([inStock])
}

model ServiceProject {
  id            String               @id @default(uuid())
  type          ServiceProjectType
  status        ServiceProjectStatus @default(draft)
  clientId      String
  client        ClientProfile        @relation(fields: [clientId], references: [id])
  partnerId     String?
  partner       PartnerProfile?      @relation("AssignedPartnerProjects", fields: [partnerId], references: [id])
  totalPrice    Decimal              @db.Decimal(12, 2)
  gpCommission  Decimal              @default(0) @db.Decimal(12, 2)
  franchiseId   String?
  city          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  hunter    HunterIrrigationProject?
  furniture FurnitureProject?

  @@index([clientId])
  @@index([partnerId])
  @@index([type, status])
}

model HunterIrrigationProject {
  id               String         @id @default(uuid())
  serviceProjectId String         @unique
  serviceProject   ServiceProject @relation(fields: [serviceProjectId], references: [id], onDelete: Cascade)
  photo            String?
  shape            String         @default("rectangle")
  lotAreaSotka     Float?
  length           Float
  width            Float
  area             Float
  lawnArea         Float?
  noWaterArea      Float?
  waterSource      String
  pressure         Float
  waterFlow        Float
  zones            Int
  zonesPlan        Json?
  sprinklers       Json
  pipes            Json
  valves           Json
  controller       Json
  filter           Json?
  fittings         Json?
  pump             Json?
  materials        Json?
  market           Json?
  aiChecks         Json?
  estimate         Json
  drawing2D        Json
}

model FurnitureProject {
  id               String         @id @default(uuid())
  serviceProjectId String         @unique
  serviceProject   ServiceProject @relation(fields: [serviceProjectId], references: [id], onDelete: Cascade)
  photo            String?
  roomWidth        Float
  roomHeight       Float
  furnitureLength  Float
  furnitureDepth   Float
  material         String
  facadeMaterial   String
  color            String
  modules          Int
  parts            Json
  hardware         Json
  estimate         Json
  drawing2D        Json
}

model Order {
  id                String        @id @default(uuid())
  clientId          String
  client            ClientProfile @relation(fields: [clientId], references: [id])
  assignedPartnerId String?
  partner           PartnerProfile? @relation("AssignedPartner", fields: [assignedPartnerId], references: [id])
  category          OrderCategory
  status            OrderStatus   @default(NEW)
  septicStage       SepticStage?
  city              String?
  regionId          String?
  serviceName       String?
  serviceId         String?
  address           String?
  clientPhone       String?
  clientName        String?
  clientLat         Float         @default(51.233)
  clientLng         Float         @default(51.367)
  executorLat       Float?
  executorLng       Float?
  total             Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus     String        @default("DIRECT_TO_PARTNER")
  septicVolume      Int?
  gpCommission      Decimal?      @db.Decimal(12, 2)
  commissionPaid    Boolean       @default(false)
  comment           String?
  preferredDate     DateTime?
  preferredTime     String?
