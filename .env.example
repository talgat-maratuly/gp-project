# =============================================================================
# GP Monorepo — переменные окружения (пример)
# Скопируйте в .env для локальной разработки. На хостинге задайте в панели сервиса.
# GP Work не входит в этот AI Assistant контур.
# =============================================================================

# --- API (Render / локально apps/api) ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://gp:gp@localhost:5432/gp?schema=public
AI_ASSISTANT_URL=http://localhost:8010
JWT_SECRET=change-me-in-production-min-32-chars

# URL фронтендов через запятую (обязательно в production на Render)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example:
# CORS_ORIGINS=https://gp-service.vercel.app,https://gp-partner.vercel.app

# --- eGov Kazakhstan / NCALayer (юрлица) ---
# mock = локальная проверка формата БИН/ИИН без хранения лишних госданных.
EGOV_PROVIDER=mock
# EGOV_PROVIDER=egov
# EGOV_API_TOKEN=
# EGOV_COMPANY_VERIFY_URL=
# NCALAYER_VERIFY_URL=
# EGOV_MOBILE_ECP_VERIFY_URL=

# --- GP Service / GP Partner (локально) ---
# apps/gp-service/.env.development и apps/gp-partner/.env.development уже задают:
# VITE_API_URL=http://localhost:4000/api
# VITE_GP_DEMO=false

# --- Production (Vercel) ---
# VITE_API_URL=https://apigp.duckdns.org/api
# --- Production VPS / DuckDNS ---
# NODE_ENV=production
# POSTGRES_USER=gp
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=gp_service
# PUBLIC_API_URL=https://apigp.duckdns.org
# AI_ASSISTANT_URL=https://ai-gp.duckdns.org
# VITE_API_URL=https://apigp.duckdns.org/api
# VITE_GP_PUBLIC_URL=https://servicegp.duckdns.org
# CORS_ORIGINS=https://servicegp.duckdns.org,https://partnergp.duckdns.org,https://admingp.duckdns.org
# JWT_SECRET=generate-a-random-secret-min-32-chars

# --- Supabase (альтернатива Render PostgreSQL) ---
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
